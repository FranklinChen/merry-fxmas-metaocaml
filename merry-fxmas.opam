depends: [
  "dune" {>= "3.24"}
  "ocaml-variants" {= "5.3.0+BER"}
  "base-metaocaml-ocamlfind"
  "ocamlfind"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/FranklinChen/merry-fxmas-metaocaml.git"
